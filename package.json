{
  "name": "goodprompts",
  "displayName": "Good Prompts",
  "publisher": "omarbanat",
  "description": "Write better prompts for AI coding assistants",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/omarbanat/good-prompts"
  },
  "license": "MIT",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "prompt",
    "ai",
    "claude",
    "copilot",
    "chatgpt",
    "prompt engineering",
    "productivity"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "goodPrompts.open",
        "title": "GoodPrompts: Open Panel"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "goodprompts",
          "title": "GoodPrompts",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "goodprompts": [
        {
          "type": "webview",
          "id": "goodPrompts.panel",
          "name": "GoodPrompts"
        }
      ]
    }
  },
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.85.0",
    "css-loader": "^6.9.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
