{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./out/extension",
    "rootDirs": ["./src/extension", "./src/shared"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/extension/**/*", "src/shared/**/*"],
  "exclude": ["node_modules", "out"]
}
