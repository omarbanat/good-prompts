{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2015",
    "jsx": "react",
    "lib": ["ES2020", "DOM"],
    "outDir": "./out/webview",
    "rootDirs": ["./src/webview", "./src/shared"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": ["src/webview/**/*", "src/shared/**/*"],
  "exclude": ["node_modules", "out"]
}
